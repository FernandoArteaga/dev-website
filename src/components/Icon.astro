---
import { Icon as AstroIcon } from "astro-icon/components";
import type { IconName } from "$/types/app.ts";

interface Props {
  name: IconName
  size?: string
  class?: string
}

const { name, size = 32, class: className } = Astro.props;
---

<AstroIcon name={name} width={size} height={size} class:list={['hover:text-primary', className]} />
